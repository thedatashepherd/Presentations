{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.13.0/schema.json",
  "name": "hourpattern",
  "position": {
    "x": 20,
    "y": 495,
    "z": 8,
    "height": 205,
    "width": 750,
    "tabOrder": 8
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Hour UTC"
                    }
                  },
                  "Property": "Hour Label"
                }
              },
              "queryRef": "Hour UTC.Hour Label",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "v_fact_wait_snapshot"
                    }
                  },
                  "Property": "Average Wait (min)"
                }
              },
              "queryRef": "v_fact_wait_snapshot.Average Wait (min)"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Column": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "Hour UTC"
                  }
                },
                "Property": "Hour Label"
              }
            },
            "direction": "Ascending"
          }
        ]
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Average wait by hour | UTC, not local'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}