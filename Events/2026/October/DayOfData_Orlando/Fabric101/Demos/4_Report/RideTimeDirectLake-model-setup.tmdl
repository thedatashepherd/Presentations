	table fact_wait_snapshot
		sourceLineageTag: [dbo].[fact_wait_snapshot_reporting]
		lineageTag: dc6136b0-6a25-4291-b4bd-80641f394ce3

		/// Snapshot-row-weighted average of nonblank, nonnegative OPERATING waits. Zero is valid; missing waits are excluded. Not guest-weighted or time-weighted.
		measure 'Average Wait (min)' = CALCULATE ( AVERAGE ( 'fact_wait_snapshot'[standby_wait_min] ), KEEPFILTERS ( 'fact_wait_snapshot'[status] = "OPERATING" ), KEEPFILTERS ( 'fact_wait_snapshot'[standby_wait_min] >= 0 ) )
			formatString: 0.0
			displayFolder: History
			lineageTag: 8def8c7a-c3ad-48d9-a11f-2ab6157cbe2c

		/// 90th percentile of valid operating wait observations, not individual guest waits.
		measure 'P90 Wait (min)' = PERCENTILEX.INC ( FILTER ( 'fact_wait_snapshot', 'fact_wait_snapshot'[status] = "OPERATING" && NOT ISBLANK ( 'fact_wait_snapshot'[standby_wait_min] ) && 'fact_wait_snapshot'[standby_wait_min] >= 0 ), 'fact_wait_snapshot'[standby_wait_min], 0.9 )
			formatString: 0.0
			displayFolder: History
			lineageTag: e0a1a60f-eef2-40e0-aae9-ffae03d9420a

		measure 'Reported Wait Observations' = COUNTROWS ( FILTER ( 'fact_wait_snapshot', 'fact_wait_snapshot'[status] = "OPERATING" && NOT ISBLANK ( 'fact_wait_snapshot'[standby_wait_min] ) && 'fact_wait_snapshot'[standby_wait_min] >= 0 ) )
			formatString: #,0
			displayFolder: History
			lineageTag: 14e48207-d8d7-4de2-b87f-d257d04a3376

		measure 'Snapshot Observations' = COUNTROWS ( 'fact_wait_snapshot' )
			formatString: #,0
			displayFolder: History
			lineageTag: 22530217-6f42-4bc8-8f58-1f518ae49e84

		/// Share of collected rows marked OPERATING. Includes overnight closures in denominator; not scheduled-hours availability or duration-weighted uptime.
		measure 'Operating Observation %' = DIVIDE ( CALCULATE ( COUNTROWS ( 'fact_wait_snapshot' ), KEEPFILTERS ( 'fact_wait_snapshot'[status] = "OPERATING" ) ), [Snapshot Observations] )
			formatString: 0.0%
			displayFolder: History
			lineageTag: e087a244-5d36-4589-b391-d72dd600fa6c

		/// Share of operating observations with a valid wait; helps distinguish missing values from zero.
		measure 'Operating Wait Coverage %' = DIVIDE ( [Reported Wait Observations], CALCULATE ( COUNTROWS ( 'fact_wait_snapshot' ), KEEPFILTERS ( 'fact_wait_snapshot'[status] = "OPERATING" ) ) )
			formatString: 0.0%
			displayFolder: History
			lineageTag: 8ae1e4f5-7cff-41e4-a453-84b33317adad

		/// Global latest whole collection visible to the Direct Lake model; ignores all report filters. Uses the currently framed Delta table version.
		measure 'Latest Collection UTC' = CALCULATE ( MAX ( 'fact_wait_snapshot'[snapshot_utc] ), REMOVEFILTERS () )
			formatString: yyyy-MM-dd HH:mm:ss
			displayFolder: Latest Snapshot
			lineageTag: cdb982e7-4ef5-47dc-8f3f-eef8b4deeaf1

		/// Minutes since latest visible collection. Updates when queried; refresh/framing exposes new Delta commits.
		measure 'Data Age (min)' = VAR LatestUTC = [Latest Collection UTC] RETURN IF ( NOT ISBLANK ( LatestUTC ), ( UTCNOW () - LatestUTC ) * 1440 )
			formatString: #,0
			displayFolder: Latest Snapshot
			lineageTag: 906ff669-9630-446c-8991-3109d1c75539

		measure 'Latest Average Wait (min)' = VAR LatestUTC = [Latest Collection UTC] RETURN CALCULATE ( [Average Wait (min)], REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Hour UTC' ), 'fact_wait_snapshot'[snapshot_utc] = LatestUTC )
			formatString: 0.0
			displayFolder: Latest Snapshot
			lineageTag: f5840a38-dd14-46bb-9d42-9978e843f372

		/// Attractions present in the latest whole collection, not every catalog attraction.
		measure 'Latest Attractions' = VAR LatestUTC = [Latest Collection UTC] RETURN CALCULATE ( DISTINCTCOUNT ( 'fact_wait_snapshot'[entity_id] ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Hour UTC' ), 'fact_wait_snapshot'[snapshot_utc] = LatestUTC )
			formatString: #,0
			displayFolder: Latest Snapshot
			lineageTag: 4887e841-8540-42bd-86fd-c2ad69d02669

		measure 'Latest Operating Attractions' = VAR LatestUTC = [Latest Collection UTC] RETURN CALCULATE ( [Latest Attractions], KEEPFILTERS ( 'fact_wait_snapshot'[status] = "OPERATING" ) )
			formatString: #,0
			displayFolder: Latest Snapshot
			lineageTag: ea676d0c-6588-4b9a-a20d-bdeabbfb9b42

		measure 'Latest Down Attractions' = CALCULATE ( [Latest Attractions], KEEPFILTERS ( 'fact_wait_snapshot'[status] = "DOWN" ) )
			formatString: #,0
			displayFolder: Latest Snapshot
			lineageTag: bb1a0dbf-731b-426f-bee3-4f49b23abefb

		/// Wait for exactly one attraction at the latest collection, only if operating and reported. Totals intentionally blank.
		measure 'Latest Wait (min)' = IF ( HASONEVALUE ( 'dim_entity'[entity_id] ), [Latest Average Wait (min)] )
			formatString: 0
			displayFolder: Latest Snapshot
			lineageTag: ec78719a-a131-4acd-99d9-bdc06f00511d

		measure 'Latest Status' = VAR LatestUTC = [Latest Collection UTC] RETURN IF ( HASONEVALUE ( 'dim_entity'[entity_id] ), CALCULATE ( SELECTEDVALUE ( 'fact_wait_snapshot'[status] ), REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Hour UTC' ), 'fact_wait_snapshot'[snapshot_utc] = LatestUTC ) )
			displayFolder: Latest Snapshot
			lineageTag: 5ef02bf1-f35c-4464-9f24-5d917e4fb052

		measure 'Latest Wait Coverage %' = VAR LatestUTC = [Latest Collection UTC] RETURN CALCULATE ( [Operating Wait Coverage %], REMOVEFILTERS ( 'Date' ), REMOVEFILTERS ( 'Hour UTC' ), 'fact_wait_snapshot'[snapshot_utc] = LatestUTC )
			formatString: 0.0%
			displayFolder: Latest Snapshot
			lineageTag: f4c90ec1-9d27-4edd-9c3b-74af9997b56a

		measure 'Overview Note' = "LATEST SNAPSHOT | UTC | Direct Lake: refresh/framing exposes Delta commits. Blank wait = unavailable, not zero."
			displayFolder: Report Labels
			lineageTag: cf6f0593-5117-4846-bf5c-8b85dcb4afdc

		measure 'History Note' = "WAIT PATTERNS | UTC | Operating rides only. Averages are observation-weighted; not park-local time."
			displayFolder: Report Labels
			lineageTag: 27008f2d-5baa-4f90-bc50-751f1c984b2b

		column snapshot_utc
			dataType: dateTime
			formatString: General Date
			lineageTag: f1feaf28-2aeb-4792-b5a3-13c53440a556
			summarizeBy: none
			sourceLineageTag: snapshot_utc
			sourceColumn: snapshot_utc

			annotation SummarizationSetBy = Automatic

